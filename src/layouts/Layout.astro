---
import '../styles/global.css';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cat from '../components/Cat.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cristóbal García Coss · Desarrollador backend .NET',
  description = 'Soy Cristóbal, desarrollador backend .NET y líder técnico en Morelos, México. Modernizo sistemas legacy hacia APIs y microservicios.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4efe6" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Cristóbal Sebastián García Coss" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />
  </head>
  <body class="min-h-screen">
    <Header />
    <main class="max-w-5xl mx-auto w-full px-6 md:px-8">
      <slot />
    </main>
    <Footer />
    <Cat />
    <ChatWidget />

    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
