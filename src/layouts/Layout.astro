---
import '../styles/global.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cat from '../components/Cat.astro';
import ChatWidget from '../components/ChatWidget.astro';
import DotField from '../components/DotField.astro';
import EasterEggs from '../components/EasterEggs.astro';
import { content, type Lang } from '../data/cv';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Politica de seguridad de contenido: solo recursos del propio sitio, sin objetos ni marcos ajenos -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" hreflang="es" href="https://portafolio.sysfactory.net/" />
    <link rel="alternate" hreflang="en" href="https://portafolio.sysfactory.net/en/" />

    <title>{c.ui.title}</title>
    <meta name="description" content={c.ui.description} />
    <meta name="author" content="Cristóbal Sebastián García Coss" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.ui.title} />
    <meta property="og:description" content={c.ui.description} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />

    <!-- aplica el modo guardado antes de pintar, para que no parpadee -->
    <script is:inline>
      (function () { try { if (localStorage.getItem('theme') === 'day') document.documentElement.dataset.theme = 'day'; } catch (e) {} })();
    </script>
  </head>
  <body class="min-h-screen">
    <DotField />
    <Header lang={lang} />
    <main class="max-w-6xl mx-auto w-full px-5 md:px-8">
      <slot />
    </main>
    <Footer lang={lang} />
    <Cat />
    <ChatWidget lang={lang} />
    <EasterEggs lang={lang} />

    <script>
      // modo dia / noche: lo cambia el boton del encabezado
      const root = document.documentElement;
      const toggleTheme = () => {
        const next = root.dataset.theme === 'day' ? 'night' : 'day';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch { /* sin storage */ }
        window.dispatchEvent(new Event('themechange'));
      };
      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);

      // aparicion al hacer scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
