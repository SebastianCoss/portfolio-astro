---
// Version imprimible del CV en ingles. De esta pagina sale public/Cristobal_Garcia_Coss_CV_2026_EN.pdf
// Se genera con Edge o Chrome en modo headless: --headless --no-pdf-header-footer --print-to-pdf=<salida> <url de esta pagina>.
// No se enlaza desde el sitio. Si cambia el contenido en ingles de cv.ts, hay que volver a generar el PDF.
import { content, site } from '../../data/cv';
const c = content.en;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>Cristóbal Sebastián García Coss · Résumé</title>
    <style>
      @page { size: Letter; margin: 14mm 15mm; }
      * { box-sizing: border-box; }
      body { font: 9.6pt/1.38 Arial, Helvetica, sans-serif; color: #111; margin: 0 auto; max-width: 186mm; padding: 8mm 0; }
      @media print { body { padding: 0; } }
      h1 { font-size: 17pt; text-align: center; margin: 0; letter-spacing: .3px; }
      .sub { text-align: center; color: #1f4e9c; font-weight: 700; font-size: 10.500pt; margin: 2px 0; }
      .contact { text-align: center; margin: 0 0 6px; }
      a { color: #1f4e9c; text-decoration: none; }
      h2 { font-size: 10.500pt; text-align: center; text-transform: uppercase; letter-spacing: .6px; border-bottom: 1.3px solid #111; padding-bottom: 2px; margin: 11px 0 5px; }
      p { margin: 0 0 4px; text-align: justify; }
      .job { margin: 6px 0 2px; }
      .job b { text-transform: uppercase; }
      ul { margin: 0 0 4px; padding-left: 16px; }
      li { margin: 1.500px 0; text-align: justify; }
      section { break-inside: auto; }
      .job, h2 { break-after: avoid; }
    </style>
  </head>
  <body>
    <h1>CRISTÓBAL SEBASTIÁN GARCÍA COSS</h1>
    <p class="sub">Senior Software Engineer · .NET Backend · Tech Lead</p>
    <p class="contact">
      Temixco, Morelos, Mexico | Remote / Hybrid | +52 777 328 6002 | <a href={`mailto:${site.email}`}>{site.email}</a><br />
      <a href={site.linkedin}>linkedin.com/in/crisegarcoss</a> | <a href={site.github}>github.com/SebastianCoss</a> | <a href={site.company}>sysfactory.net</a> | <a href="https://portafolio.sysfactory.net/en/">portafolio.sysfactory.net</a>
    </p>

    <h2>Professional Profile</h2>
    <p>
      ICT engineer with over 5 years of experience in backend development and software architecture. I specialize in modernizing
      legacy systems into APIs and microservices with .NET 10/9/8 and Java (Spring Boot), following Clean Architecture and deploying
      on Azure. I have been the tech lead of production projects for the financial and enterprise sectors. I integrate AI agents
      across the whole development cycle, and I led the AWS User Group Morelos community.
    </p>

    <h2>Professional Experience</h2>
    {c.jobs.map((j) => (
      <section>
        <p class="job"><b>{j.company}</b> | {j.role} | {j.period}</p>
        <ul>{j.highlights.map((h) => <li><b>{h.title}:</b> {h.text}</li>)}</ul>
      </section>
    ))}

    <h2>Projects | Full-stack Developer | May 2024 – Present</h2>
    <ul>
      {c.projects.map((p) => <li><b>{p.name} ({p.status.toLowerCase()}):</b> {p.text}</li>)}
    </ul>

    <h2>Technical Skills</h2>
    <ul>
      {c.stackGroups.map((g) => <li><b>{g.title}:</b> {g.items.join(', ').replaceAll(' · ', ', ')}</li>)}
    </ul>

    <h2>Education and Certifications</h2>
    <ul>
      {c.education.map((e) => <li><b>{e.title}:</b> {e.place}, {e.period}.</li>)}
      <li><b>Leadership:</b> led AWS User Group Morelos and spoke on "EC2 vs. Lambda for Backend Devs".</li>
      <li><b>Languages:</b> Spanish (native) · English B1 (working toward B2).</li>
    </ul>
  </body>
</html>
