---
// Ficha del CV: se queda fija a la izquierda en pantallas anchas.
import { content, site, type Lang } from '../data/cv';
import Art from './Art.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang];
const ui = c.ui;
const waText = lang === 'es' ? 'Hola Cristóbal, vi tu portafolio y me gustaría platicar.' : 'Hi Cristóbal, I saw your portfolio and would like to talk.';
const wa = `${site.whatsapp}?text=${encodeURIComponent(waText)}`;
const contact = [
  { label: ui.mail, text: site.email, href: `mailto:${site.email}` },
  { label: 'GitHub', text: 'SebastianCoss', href: site.github },
  { label: ui.companyLabel, text: 'sysfactory.net', href: site.company },
];
---

<aside class="lg:sticky lg:top-20 lg:self-start space-y-4">
  <div data-perch class="card art-host">
    <div class="card-art h-28 bg-c-blue"><Art kind="nodes" /></div>
    <div class="p-6">
      <h1 class="text-[1.7rem]">Cristóbal Sebastián García Coss</h1>
      <p class="mt-2 text-cream/80">{ui.role1}<br />{ui.role2}</p>
      <p class="note mt-3">{ui.location1}<br />{ui.location2}</p>
      <div class="mt-5 grid gap-2">
        <a href={site.cv[lang]} download class="btn btn-solid justify-center">{ui.downloadCv}</a>
        <button type="button" data-open-chat class="btn btn-line justify-center">{ui.askCv}</button>
      </div>
    </div>
  </div>

  <div class="block-panel p-6">
    <h2 class="side-title">{ui.writeMe}</h2>
    <div class="grid grid-cols-3 gap-2">
      <a href={wa} target="_blank" rel="noopener noreferrer" class="on-color lift rounded-lg bg-c-green py-3 grid place-items-center gap-1 text-[12px] font-bold">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.600 15.100L2 22l5.100-1.300A10 10 0 1 0 12 2Zm5.300 13.900c-.200.600-1.300 1.200-1.800 1.200-.500.100-1 .200-3.300-.700-2.800-1.100-4.500-3.900-4.700-4.100-.100-.200-1.100-1.500-1.100-2.800s.700-2 .900-2.300c.200-.200.500-.300.700-.300h.500c.200 0 .400 0 .600.500l.900 2.100c.100.200.100.400 0 .600l-.800 1c-.200.200-.300.400-.100.700.900 1.500 2 2.300 3.300 2.900.300.100.500.100.700-.100l.900-1.100c.200-.300.400-.200.700-.100l2 1c.300.100.500.200.600.300.100.200.100.700-.100 1.200Z" /></svg>
        {ui.whatsapp}
      </a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="on-color lift rounded-lg bg-c-blue py-3 grid place-items-center gap-1 text-[12px] font-bold">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4.500 3.500a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3 9h3v12H3zM9 9h2.900v1.700c.500-.900 1.700-2 3.600-2 3.300 0 4.500 2.100 4.500 5.300V21h-3v-6.200c0-1.500-.500-2.600-1.900-2.600-1.500 0-2.100 1.100-2.100 2.600V21H9z" /></svg>
        {ui.linkedin}
      </a>
      <a href={`mailto:${site.email}`} class="on-color lift rounded-lg bg-c-red py-3 grid place-items-center gap-1 text-[12px] font-bold">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 8.200L20 8V7l-8 5.200L4 7v1l8 5.200Z" /></svg>
        {ui.emailBtn}
      </a>
    </div>
    <ul class="space-y-2.5 mt-5">
      {contact.map((x) => (
        <li>
          <p class="note !text-[11px]">{x.label}</p>
          <a href={x.href} target={x.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="font-medium break-all hover:underline underline-offset-4">{x.text}</a>
        </li>
      ))}
    </ul>
  </div>

  <div class="block-panel p-6">
    <h2 class="side-title">{ui.education}</h2>
    <ul class="space-y-3">
      {c.education.map((e) => (
        <li>
          <p class="font-medium leading-snug">{e.title}</p>
          <p class="text-cream/65 text-[14.5px] leading-snug">{e.place}</p>
          <p class="note !text-[11px] mt-0.5">{e.period}</p>
        </li>
      ))}
    </ul>
    <h2 class="side-title mt-6">{ui.languages}</h2>
    {c.languages.map((l) => <p class="text-[15px]">{l.name} <span class="text-cream/60">{l.level}</span></p>)}
  </div>
</aside>
