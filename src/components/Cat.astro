---
// Gato negro en pixel art. Los cuadros estan dibujados a mano como texto (ver FRAMES) y se pintan
// en un <canvas>. Camina por el piso y por los bloques marcados con data-perch, salta si el cursor
// sube, se deja caer si baja y manotea al cursor cuando lo tiene cerca.
// Solo con mouse; respeta prefers-reduced-motion; se apaga con el boton de la esquina.
---

<div id="cat" class="cat" aria-hidden="true" hidden>
  <canvas id="cat-canvas" width="112" height="72"></canvas>
  <span class="cat-bubble"></span>
</div>
<div id="cat-marks" aria-hidden="true"></div>

<button id="cat-toggle" type="button" class="cat-toggle" aria-pressed="true" aria-label="Apagar o encender al gato" title="Gato">
  <svg viewBox="-1 -1 14 12" width="26" height="22" aria-hidden="true">
    <path d="M1 0h2v1h1v1h4V1h1V0h2v7h-1v2H2V7H1z" fill="#08080b" stroke="#f4f1d2" stroke-width=".7" />
    <path d="M3 4h2v2H3zM7 4h2v2H7z" fill="#ffd23f" />
  </svg>
</button>

<style is:global>
  .cat { position: fixed; left: 0; top: 0; z-index: 40; pointer-events: none; will-change: transform; width: 112px; height: 72px; }
  .cat[hidden] { display: none; }
  .cat canvas { display: block; image-rendering: pixelated; transform-origin: 50% 80%; }
  .cat.land canvas { animation: cat-squash .2s steps(3); }
  .cat-bubble {
    position: absolute; top: -18px; left: 50%; translate: -50% 0; opacity: 0;
    padding: 2px 8px; background: #f4f1d2; color: #0b1920;
    font: 400 12px/1.4 "IBM Plex Mono", monospace; white-space: nowrap;
    box-shadow: 3px 3px 0 rgba(0,0,0,.35);
  }
  .cat.say .cat-bubble { opacity: 1; }

  #cat-marks { position: fixed; inset: 0; pointer-events: none; z-index: 39; }
  .scratch { position: absolute; width: 36px; height: 36px; animation: scratch-fade 1s steps(6) forwards; }
  .scratch i { position: absolute; top: 0; width: 4px; height: 100%; background: #f4f1d2; transform: skewX(-24deg); }
  .scratch i:nth-child(1) { left: 6px; height: 80%; }
  .scratch i:nth-child(2) { left: 16px; }
  .scratch i:nth-child(3) { left: 26px; height: 80%; top: 20%; }

  .cat-toggle {
    position: fixed; left: 16px; bottom: 16px; z-index: 50; width: 46px; height: 46px; border-radius: 10px;
    display: grid; place-items: center; cursor: pointer;
    border: 2px solid #f4f1d2; background: #12252e; transition: opacity .2s, background .2s;
  }
  .cat-toggle:hover { background: #1a323d; }
  .cat-toggle[aria-pressed="false"] { opacity: .45; }

  .cat-ball { position: absolute; left: 0; top: 0; width: 22px; height: 22px; border-radius: 50%; background: #d5503f; box-shadow: inset -4px -4px 0 rgba(0,0,0,.28), inset 3px 3px 0 rgba(255,255,255,.22), 0 0 0 2px #f4f1d2; }
  .cat-ball::before { content: ""; position: absolute; inset: 5px 3px; border-top: 2px solid rgba(244,241,210,.8); border-bottom: 2px solid rgba(244,241,210,.8); border-radius: 50%; }
  .cat-heart { position: absolute; color: #d5503f; font: 700 20px/1 "IBM Plex Mono", monospace; text-shadow: 2px 2px 0 rgba(0,0,0,.4); animation: cat-heart 1.25s ease-out forwards; }
  @keyframes cat-heart { 0% { opacity: 0; transform: translateY(0) scale(.6); } 20% { opacity: 1; } 100% { opacity: 0; transform: translateY(-46px) scale(1.2); } }
  @keyframes cat-squash { 0% { transform: scale(1.15, .8); } 100% { transform: scale(1); } }
  @keyframes scratch-fade { 0% { opacity: 1; } 70% { opacity: 1; } 100% { opacity: 0; } }
  @media (pointer: coarse), (prefers-reduced-motion: reduce) { .cat, .cat-toggle, #cat-marks { display: none !important; } }
</style>

<script>
  const cat = document.getElementById('cat') as HTMLElement | null;
  const canvas = document.getElementById('cat-canvas') as HTMLCanvasElement | null;
  const marks = document.getElementById('cat-marks') as HTMLElement | null;
  const toggle = document.getElementById('cat-toggle') as HTMLButtonElement | null;
  const fine = window.matchMedia('(pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cat && canvas && marks && toggle && fine && !calm) {
    // ---------- sprites ----------
    const GW = 26, GH = 16, S = 4;                  // rejilla logica y escala
    const INK: Record<string, string> = { k: '#08080b', g: '#34343e', y: '#ffd23f', w: '#f4f1d2' };
    const OUTLINE = '#d9d5b8';

    const BODY = [
      '..................k..k..',
      '..................kk.kk.',
      '.k................kkkkk.',
      'k.................kykyk.',
      'k.................kkkkk.',
      'k.....kkkkkkkkkkkkkkkk..',
      '.k...kkkkkkkkkkkkkkkk...',
      '..kkkkkkkkkkkkkkkkkkk...',
      '.....kkkkkkkkkkkkkkkk...',
      '.....kkkkkkkkkkkkkkk....',
    ];
    const LEGS = {
      stand: ['.....kk.kk.....kk.kk....', '.....kk.kk.....kk.kk....', '.....kk.kk.....kk.kk....'],
      wide:  ['....kk..kk......kk..kk..', '...kk....kk......kk..kk.', '..kk......k.......k...kk'],
      tuck:  ['......kk.kk...kk.kk.....', '.......kkk.....kkk......', '........k.......k.......'],
    };
    const SIT = [
      '..................k..k..',
      '..................kk.kk.',
      '..................kkkkk.',
      '..................kykyk.',
      '..................kkkkk.',
      '...............kkkkkkk..',
      '..............kkkkkkkk..',
      '.............kkkkkkkkk..',
      '............kkkkkkkkkk..',
      '...k........kkkkkkkkkk..',
      '..k........kkkkkkkkkkk..',
      '..k........kkkkkk.kk.k..',
      '...kkkkkkkkkkkkkk.kk.kk.',
    ];
    const SIT2 = [...SIT.slice(0, 9),
      '..k.........kkkkkkkkkk..',
      '.k.........kkkkkkkkkkk..',
      '.k.........kkkkkk.kk.k..',
      '..kkkkkkkkkkkkkkk.kk.kk.',
    ];
    const SLEEP = [
      '...............k..k.....',
      '....kkkkkkkkkkkkkkkk....',
      '..kkkkkkkkkkkkkkkkkkk...',
      '.kkkkkkkkkkkkkkkgkgkk...',
      '.kkkkkkkkkkkkkkkkkkkkk..',
      'kkkkkkkkkkkkkkkkkkkkkk..',
    ];

    type Grid = string[][];
    const grid = (rows: string[]): Grid => {
      const g: Grid = [];
      for (let i = 0; i < GH - rows.length; i++) g.push(Array(GW).fill('.'));
      rows.forEach((r) => g.push(r.padEnd(GW, '.').split('')));
      return g;
    };
    const put = (g: Grid, dots: [number, number, string][]): Grid => {
      const c = g.map((r) => [...r]);
      const off = GH - 13;                              // las coordenadas son relativas a SIT (13 filas)
      dots.forEach(([r, col, ch]) => { c[r + off][col] = ch; });
      return c;
    };
    const blink = (g: Grid): Grid => g.map((r) => r.map((ch) => (ch === 'y' ? 'g' : ch)));

    const sit = grid(SIT);
    const FR: Record<string, Grid> = {
      stand: grid([...BODY, ...LEGS.stand]),
      wide: grid([...BODY, ...LEGS.wide]),
      tuck: grid([...BODY, ...LEGS.tuck]),
      sit,
      sit2: grid(SIT2),
      sitBlink: blink(sit),
      sleep: grid(SLEEP),
      // manotazo: pata arriba con garras, luego pata abajo
      swat1: put(sit, [[6, 22, 'k'], [5, 23, 'k'], [4, 24, 'k'], [3, 24, 'w'], [3, 25, 'w'], [4, 25, 'w']]),
      swat2: put(sit, [[7, 22, 'k'], [8, 23, 'k'], [9, 24, 'k'], [10, 24, 'w'], [10, 25, 'w'], [9, 25, 'w']]),
    };

    const ctx = canvas.getContext('2d')!;
    let shown = '';
    const draw = (name: string) => {
      if (name === shown) return;
      shown = name;
      const g = FR[name];
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const filled = (r: number, c: number) => r >= 0 && r < GH && c >= 0 && c < GW && g[r][c] !== '.';
      // contorno claro para que el gato negro se lea sobre fondo oscuro
      ctx.fillStyle = OUTLINE;
      for (let r = -1; r <= GH; r++) for (let c = -1; c <= GW; c++) {
        if (filled(r, c)) continue;
        if (filled(r - 1, c) || filled(r + 1, c) || filled(r, c - 1) || filled(r, c + 1)) ctx.fillRect((c + 1) * S, (r + 1) * S, S, S);
      }
      for (let r = 0; r < GH; r++) for (let c = 0; c < GW; c++) {
        const ch = g[r][c];
        if (ch === '.') continue;
        ctx.fillStyle = INK[ch];
        ctx.fillRect((c + 1) * S, (r + 1) * S, S, S);
      }
    };

    // ---------- fisica ----------
    const W = canvas.width, FEET = (GH + 1) * S;      // distancia de la cima del sprite a las patas
    const G = 0.5, SPEED = 2.5;
    let enabled = true;
    try { enabled = localStorage.getItem('cat') !== 'off'; } catch { /* sin storage */ }

    type Plat = { el: Element | null; l: number; r: number; t: number };
    let mx = innerWidth * 0.6, my = innerHeight * 0.5;
    let lastMoveAt = performance.now(), lastX = mx, lastY = my, curSpeed = 0;
    let x = innerWidth * 0.3, y = innerHeight, vx = 0, vy = 0;   // x = centro, y = patas
    let ground: Element | null = null, grounded = true, face = 1, tilt = 0;
    let mode: 'walk' | 'sit' | 'sleep' | 'swat' | 'air' = 'sit';
    let jumpCool = 0, swatAt = 0, frame = 0, talk: number | undefined, raf = 0;
    const bubble = cat.querySelector('.cat-bubble') as HTMLElement;

    const say = (t: string, ms = 1400) => {
      bubble.textContent = t; cat.classList.add('say'); clearTimeout(talk);
      talk = window.setTimeout(() => cat.classList.remove('say'), ms);
    };
    const platforms = (): Plat[] => {
      const out: Plat[] = [];
      document.querySelectorAll('[data-perch]').forEach((el) => {
        const b = el.getBoundingClientRect();
        if (b.width < 130 || b.top < 80 || b.top > innerHeight - 30) return;
        out.push({ el, l: b.left, r: b.right, t: b.top });
      });
      out.push({ el: null, l: 0, r: innerWidth, t: innerHeight });
      return out;
    };
    const rectOf = (el: Element | null): Plat | null => {
      if (!el) return { el: null, l: 0, r: innerWidth, t: innerHeight };
      const b = el.getBoundingClientRect();
      if (b.top < 70 || b.top > innerHeight - 20) return null;   // el bloque se fue de la pantalla: el gato cae
      return { el, l: b.left, r: b.right, t: b.top };
    };
    const scratchAt = (px: number, py: number) => {
      const s = document.createElement('div');
      s.className = 'scratch'; s.style.left = px - 18 + 'px'; s.style.top = py - 18 + 'px';
      s.append(document.createElement('i'), document.createElement('i'), document.createElement('i'));
      marks.appendChild(s);
      setTimeout(() => s.remove(), 1050);
    };

    addEventListener('mousemove', (e) => {
      const now = performance.now();
      curSpeed = Math.hypot(e.clientX - lastX, e.clientY - lastY) / Math.max(now - lastMoveAt, 1);
      mx = e.clientX; my = e.clientY; lastX = mx; lastY = my; lastMoveAt = now;
      if (mode === 'sleep') { mode = 'sit'; say('?'); }
    }, { passive: true });
    // Bola de estambre: rebota en el piso, las paredes y los bloques; el gato la persigue y la patea.
    let ball: HTMLElement | null = null, bx = 0, by = 0, bvx = 0, bvy = 0, ballUntil = 0;
    const BR = 11;
    const throwBall = () => {
      if (!ball) { ball = document.createElement('div'); ball.className = 'cat-ball'; marks.appendChild(ball); }
      bx = x + face * 30; by = y - 50; bvx = face * (4 + Math.random() * 3); bvy = -9;
      ballUntil = performance.now() + 11000;
    };
    const kickBall = () => { bvx = face * (3.5 + Math.random() * 4); bvy = -(6.5 + Math.random() * 3.5); };
    const stepBall = (now: number) => {
      if (!ball) return;
      if (now > ballUntil) { ball.remove(); ball = null; say('…', 900); return; }
      const prev = by;
      bvy += 0.42; bx += bvx; by += bvy; bvx *= 0.992;
      if (bx < BR) { bx = BR; bvx = Math.abs(bvx) * 0.8; }
      if (bx > innerWidth - BR) { bx = innerWidth - BR; bvx = -Math.abs(bvx) * 0.8; }
      if (bvy > 0) {
        const hit = platforms().filter((p) => bx > p.l && bx < p.r && prev + BR <= p.t + 2 && by + BR >= p.t).sort((a, b) => a.t - b.t)[0];
        if (hit) { by = hit.t - BR; bvy = -bvy * 0.62; bvx *= 0.9; if (Math.abs(bvy) < 1.6) bvy = 0; }
      }
      ball.style.transform = `translate(${Math.round(bx - BR)}px, ${Math.round(by - BR)}px) rotate(${Math.round(bx * 3)}deg)`;
      ball.style.opacity = ballUntil - now < 900 ? String((ballUntil - now) / 900) : '1';
    };

    // Clic sobre el gato: ronronea con corazones; cada tercer clic (o si estaba dormido) se asusta y brinca.
    const heartAt = (px: number, py: number) => {
      const h = document.createElement('div');
      h.className = 'cat-heart'; h.textContent = '♥';
      h.style.left = px + (Math.random() * 40 - 20) + 'px'; h.style.top = py + 'px';
      marks.appendChild(h);
      setTimeout(() => h.remove(), 1300);
    };
    let clicks = 0, purrUntil = 0;
    addEventListener('mousedown', (e) => {
      const onCat = Math.abs(e.clientX - x) < 56 && e.clientY > y - 78 && e.clientY < y + 8;
      if (onCat && grounded) {
        // clic al gato: saca una bola de estambre y se pone a jugar con ella
        lastMoveAt = performance.now(); purrUntil = 0;
        throwBall();
        say('¡a jugar!', 1300);
        heartAt(x, y - 78);
      } else if (Math.hypot(mx - x, my - (y - 36)) < 170) say('¡fsss!', 1100);
    });

    // Salto balistico desde donde esta hasta (tx, ty); "extra" es cuanto sube por encima del punto mas alto.
    // "dest" es el bloque donde debe aterrizar (null = piso). Mientras va hacia el, atraviesa los demas:
    // sin esto, al saltar hacia abajo volvia a caer sobre el mismo bloque del que salio.
    let dest: Element | null | undefined;
    const jumpTo = (tx: number, ty: number, extra = 48, target?: Element | null) => {
      const apexY = Math.min(y, ty) - extra;
      vy = -Math.sqrt(2 * G * (y - apexY));
      const tAir = -vy / G + Math.sqrt((2 * (ty - apexY)) / G);
      vx = Math.max(-11, Math.min(11, (tx - x) / tAir));
      grounded = false; ground = null; dest = target;
      if (Math.abs(vx) > 0.2) face = vx > 0 ? 1 : -1;
    };

    // Ritmo del gato: cuanto espera antes de volver a saltar y cuanto debe quedarse quieto el cursor.
    const REST = 75;          // cuadros de descanso tras aterrizar (~1.2 s)
    const DWELL = 450;        // ms que el cursor debe llevar sobre otro nivel antes de saltar hacia el
    let wantEl: Element | null | undefined, wantSince = 0, leapCool = 0, walking = false;

    // Un paso de simulacion. Se ejecuta a 60 pasos por segundo fijos (ver tick), sin importar
    // si la pantalla es de 60, 120 o 144 Hz: antes el gato iba al doble de velocidad en pantallas rapidas.
    const step = () => {
      const now = performance.now();
      stepBall(now);
      const playing = !!ball;
      const cx = playing ? bx : mx, cy = playing ? by : my;   // persigue la bola si hay, si no el cursor
      const idle = playing ? 0 : now - lastMoveAt;
      const dist = Math.hypot(cx - x, cy - (y - 36));
      frame++;

      if (grounded) {
        const here = rectOf(ground);
        if (!here) { grounded = false; ground = null; dest = undefined; vx = 0; vy = 0; }
        else {
          y = here.t;
          if (jumpCool > 0) jumpCool--;
          if (leapCool > 0) leapCool--;
          const active = idle < 5000;
          // superficie que el cursor tiene debajo (bloque o piso): ahi quiere estar el gato
          const under = platforms()
            .filter((p) => cx > p.l - 10 && cx < p.r + 10 && p.t >= cy - 24)
            .sort((a, b) => a.t - b.t)[0];
          let tx = playing ? cx : cx + (x < cx ? -96 : 96);                     // al lado del cursor, sin taparlo
          let jumped = false;

          // el cursor debe quedarse un momento sobre el otro nivel; pasar de largo no dispara saltos
          const other = under && under.el !== ground ? under : null;
          if (!other) wantEl = undefined;
          else if (wantEl !== other.el) { wantEl = other.el; wantSince = now; }
          const settled = !!other && now - wantSince > (playing ? 150 : DWELL);

          const purring = now < purrUntil;
          if (purring) { jumped = true; mode = 'sit'; if (frame % 22 === 0) heartAt(x, y - 74); }
          if (!purring && active && jumpCool === 0 && other && settled) {
            // otro nivel (arriba o abajo): saltar hacia alla
            const lx = Math.min(Math.max(cx, other.l + 34), other.r - 34);
            const rise = y - other.t;
            if (rise < 400 && Math.abs(lx - x) < 520) { jumpTo(lx, other.t, rise > 0 ? 44 : 30, other.el); jumped = true; }
            else tx = lx;                                        // muy lejos: acercarse primero caminando
          }
          if (!jumped && !playing && active && jumpCool === 0 && leapCool === 0 && idle > 500 && cy < y - 110 && Math.abs(cx - x) < 150) {
            // cursor quieto arriba y sin bloque donde subirse: de vez en cuando brinca para alcanzarlo
            jumpTo(x + (cx - x) * 0.5, y, Math.min(y - cy - 16, 220)); jumped = true; leapCool = 260;
          }

          if (!jumped) {
            if (dist < (playing ? 70 : 118) && idle < 3000) {
              mode = 'swat'; walking = false; face = cx >= x ? 1 : -1;
              if (now - swatAt > (playing ? 700 : 950)) {
                swatAt = now; if (playing) kickBall(); else scratchAt(cx, cy);
                if (Math.random() < 0.25) say(['¡mrrau!', 'zas', '¡mío!'][Math.floor(Math.random() * 3)], 900);
              }
            } else if (idle > 9000) {
              mode = 'sleep'; walking = false;
              if (frame % 240 === 0) say('z z z', 2200);
            } else {
              const d = tx - x;
              // empieza a caminar solo si el objetivo se alejo de verdad, y se detiene al llegar
              if (!walking && Math.abs(d) > (playing ? 20 : 70)) walking = true;
              if (walking && Math.abs(d) <= 10) walking = false;
              if (walking) {
                const sp = playing ? SPEED * 1.5 : Math.abs(d) > 320 ? SPEED * 1.4 : SPEED;
                x += Math.sign(d) * Math.min(Math.abs(d) * 0.07 + 0.4, sp); face = d > 0 ? 1 : -1; mode = 'walk';
                const cl = Math.min(Math.max(x, here.l + 26), here.r - 26);
                if (cl !== x) { x = cl; walking = false; mode = 'sit'; }      // llego al borde del bloque: espera ahi
              } else { mode = 'sit'; face = cx >= x ? 1 : -1; }
            }
          }
        }
      }

      if (!grounded) {
        mode = 'air'; walking = false;
        const prevY = y;
        vy += G; x += vx; y += vy;
        if (vy > 0) {
          const hit = platforms()
            .filter((p) => (dest === undefined || p.el === dest || p.el === null) && x > p.l + 6 && x < p.r - 6 && prevY <= p.t + 4 && y >= p.t)
            .sort((a, b) => a.t - b.t)[0];
          if (hit) {
            y = hit.t; ground = hit.el; grounded = true; dest = undefined; vx = 0; vy = 0; mode = 'sit';
            jumpCool = playing ? 30 : REST;
            cat.classList.add('land'); setTimeout(() => cat.classList.remove('land'), 220);
          }
        }
        tilt = Math.max(-28, Math.min(28, vy * 2.6));
      } else tilt = 0;

      x = Math.min(Math.max(x, W / 2), innerWidth - W / 2);
    };

    let lastTs = 0, acc = 0;
    const STEP_MS = 1000 / 60;
    const tick = (ts: number) => {
      // pasos fijos de 60 Hz; si la pestana estuvo en pausa no intenta "ponerse al dia" de golpe
      acc += Math.min(ts - (lastTs || ts), 100); lastTs = ts;
      let n = 0;
      while (acc >= STEP_MS && n < 4) { step(); acc -= STEP_MS; n++; }
      if (n === 4) acc = 0;
      const now = performance.now();

      // cuadro segun el modo
      let name = 'sit';
      if (mode === 'walk') name = ['wide', 'stand', 'tuck', 'stand'][Math.floor(frame / 6) % 4];
      else if (mode === 'air') name = vy < 0 ? 'wide' : 'tuck';
      else if (mode === 'swat') name = Math.floor(frame / 8) % 2 ? 'swat2' : 'swat1';
      else if (mode === 'sleep') name = 'sleep';
      else if (now < purrUntil) name = Math.floor(frame / 9) % 2 ? 'sit2' : 'sitBlink';   // ojos cerrados y cola rapida
      else name = frame % 260 < 8 ? 'sitBlink' : Math.floor(frame / 40) % 2 ? 'sit2' : 'sit';
      draw(name);

      canvas.style.transform = `scaleX(${face}) rotate(${tilt}deg)`;
      cat.style.transform = `translate(${Math.round(x - W / 2)}px, ${Math.round(y - FEET)}px)`;
      raf = requestAnimationFrame(tick);
    };

    const apply = () => {
      toggle.setAttribute('aria-pressed', String(enabled));
      cat.hidden = !enabled; cancelAnimationFrame(raf);
      if (enabled) { lastMoveAt = performance.now(); raf = requestAnimationFrame(tick); }
      try { localStorage.setItem('cat', enabled ? 'on' : 'off'); } catch { /* sin storage */ }
    };
    toggle.addEventListener('click', () => { enabled = !enabled; apply(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) cancelAnimationFrame(raf); else if (enabled) raf = requestAnimationFrame(tick); });
    apply();
  }
</script>
