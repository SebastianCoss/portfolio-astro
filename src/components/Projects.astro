---
import { Image } from 'astro:assets';
import erpTallerImg from '../assets/projects/erp-taller.png';
import { projects } from '../data/cv';
---

<section id="proyectos" class="py-16 border-t border-line">
  <h2 data-perch class="text-3xl md:text-4xl font-semibold mb-3 reveal">Cosas que he construido</h2>
  <p class="text-muted mb-12 max-w-2xl reveal">Algunas son de clientes, otras son mías. Las marco para que se note cuál es cuál.</p>
  <div class="grid md:grid-cols-2 gap-8">
    {projects.map((p) => (
      <article data-perch class:list={['box p-6 flex flex-col reveal', p.featured && 'md:col-span-2']}>
        {p.featured && (
          <Image src={erpTallerImg} alt="Captura del ERP para taller automotriz" class="w-full max-h-64 object-cover object-top rounded border border-line mb-5" />
        )}
        <div class="flex items-baseline justify-between gap-4 mb-2">
          <h3 class="text-xl font-semibold">{p.name}</h3>
          <span class="note whitespace-nowrap">{p.status}</span>
        </div>
        <p class="text-muted mb-5 flex-1">{p.text}</p>
        <div class="flex flex-wrap gap-1.5">
          {p.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </article>
    ))}
  </div>
</section>
