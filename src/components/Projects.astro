---
import { projects } from '../data/cv';
import Art from './Art.astro';
const look = [
  { color: 'bg-c-mustard', art: 'stairs' },
  { color: 'bg-c-teal', art: 'dots' },
  { color: 'bg-c-blue', art: 'triangle' },
  { color: 'bg-c-pink', art: 'wave' },
  { color: 'bg-c-orange', art: 'split' },
  { color: 'bg-c-green', art: 'arcs' },
];
---

<section id="proyectos" class="py-14">
  <h2 class="text-3xl md:text-5xl mb-3 reveal">Cosas que he construido</h2>
  <p class="text-cream/70 text-lg mb-10 max-w-2xl reveal">Unas son de clientes y otras son mías. Cada tarjeta dice en qué etapa va.</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {projects.map((p, i) => (
      <article data-perch class="card reveal">
        <div class:list={['card-art h-44', look[i % look.length].color]}>
          <Art kind={look[i % look.length].art} />
        </div>
        <div class="p-6 flex-1 flex flex-col">
          <p class="note mb-2">{p.status}</p>
          <h3 class="text-xl mb-2">{p.name}</h3>
          <p class="text-cream/70 text-[15.5px] mb-5 flex-1">{p.text}</p>
          <div class="flex flex-wrap gap-1.5">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
