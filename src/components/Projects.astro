---
import { projects } from '../data/cv';
import Art from './Art.astro';
const look = [
  { color: 'bg-c-mustard', art: 'stairs' },
  { color: 'bg-c-teal', art: 'dots' },
  { color: 'bg-c-blue', art: 'triangle' },
  { color: 'bg-c-pink', art: 'wave' },
  { color: 'bg-c-orange', art: 'split' },
  { color: 'bg-c-green', art: 'arcs' },
];
---

<section id="proyectos">
  <h2 class="sec-title"><span class="bg-c-mustard"></span>Proyectos</h2>
  <div class="grid sm:grid-cols-2 gap-4">
    {projects.map((p, i) => (
      <article data-perch class="card reveal">
        <div class:list={['card-art h-24', look[i % look.length].color]}>
          <Art kind={look[i % look.length].art} />
        </div>
        <div class="p-5 flex-1 flex flex-col">
          <div class="flex items-baseline justify-between gap-3 mb-1.5">
            <h3 class="text-lg">{p.name}</h3>
            <span class="note !text-[11px] whitespace-nowrap">{p.status}</span>
          </div>
          <p class="text-cream/70 text-[15px] mb-4 flex-1">{p.text}</p>
          <div class="flex flex-wrap gap-1.5">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
