---
import { content, type Lang } from '../data/cv';
import Art from './Art.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang];
const look = [
  { color: 'bg-c-mustard', art: 'gear' },
  { color: 'bg-c-teal', art: 'cup' },
  { color: 'bg-c-blue', art: 'camera' },
  { color: 'bg-c-pink', art: 'mic' },
  { color: 'bg-c-orange', art: 'baby' },
  { color: 'bg-c-green', art: 'house' },
];
---

<section id="proyectos">
  <h2 class="sec-title"><span class="bg-c-mustard"></span>{c.ui.secProjects}</h2>
  <div class="grid sm:grid-cols-2 gap-4">
    {c.projects.map((p, i) => (
      <article data-perch class="card art-host reveal">
        <div class:list={['card-art h-24', look[i % look.length].color]}>
          <Art kind={look[i % look.length].art} />
        </div>
        <div class="p-5 flex-1 flex flex-col">
          <div class="flex items-baseline justify-between gap-3 mb-1.5">
            <h3 class="text-lg">{p.name}</h3>
            <span class="note !text-[11px] whitespace-nowrap">{p.status}</span>
          </div>
          <p class="text-cream/70 text-[15px] mb-4 flex-1">{p.text}</p>
          <div class="flex flex-wrap gap-1.5">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          {p.repo && (
            <a href={p.repo} target="_blank" rel="noopener noreferrer" class="mt-4 font-bold text-[15px] underline underline-offset-4 hover:no-underline self-start">{c.ui.repo}</a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
