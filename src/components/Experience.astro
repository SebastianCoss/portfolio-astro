---
import { jobs } from '../data/cv';
import Art from './Art.astro';
const look = [
  { color: 'bg-c-blue', art: 'nodes' },
  { color: 'bg-c-red', art: 'phone' },
  { color: 'bg-c-purple', art: 'grid' },
  { color: 'bg-c-green', art: 'bars' },
];
---

<section id="experiencia" class="py-14">
  <h2 class="text-3xl md:text-5xl mb-3 reveal">Dónde he trabajado</h2>
  <p class="text-cream/70 text-lg mb-10 max-w-2xl reveal">Cuatro etapas, de la más reciente a la primera.</p>
  <div class="grid md:grid-cols-2 gap-5">
    {jobs.map((job, i) => (
      <article data-perch class="card reveal">
        <div class:list={['card-art h-40', look[i % look.length].color]}>
          <Art kind={look[i % look.length].art} />
          {job.current && <span class="absolute top-3 right-3 font-mono text-[11px] uppercase px-2 py-1 rounded bg-cream text-night">Ahora</span>}
        </div>
        <div class="p-6 md:p-7 flex-1">
          <p class="note mb-2">{job.period}</p>
          <h3 class="text-2xl">{job.company}</h3>
          <p class="text-cream/70 mb-5">{job.role}</p>
          <ul class="space-y-3 text-[15.5px]">
            {job.highlights.map((h) => (
              <li><strong>{h.title}.</strong> <span class="text-cream/70">{h.text}</span></li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
