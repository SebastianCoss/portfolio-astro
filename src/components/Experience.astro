---
import { jobs } from '../data/cv';
---

<section id="experiencia" class="py-16 border-t border-line">
  <h2 data-perch class="text-3xl md:text-4xl font-semibold mb-12 reveal">Dónde he trabajado</h2>
  <div class="space-y-14">
    {jobs.map((job) => (
      <article class="grid md:grid-cols-[13rem_1fr] gap-4 md:gap-10 reveal">
        <div>
          <p class="note">{job.period}</p>
          {job.current && <p class="mt-1 inline-block text-[11px] font-mono px-2 py-0.5 rounded bg-rust text-paper">ahora</p>}
        </div>
        <div>
          <h3 data-perch class="text-2xl font-semibold">{job.company}</h3>
          <p class="text-muted mb-4">{job.role}</p>
          <ul class="space-y-2.5">
            {job.highlights.map((h) => (
              <li data-perch class="pl-4 relative before:content-['–'] before:absolute before:left-0 before:text-rust">
                <strong class="font-semibold">{h.title}.</strong> <span class="text-muted">{h.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
