---
import { jobs } from '../data/cv';
---

<section class="space-y-10" id="experience">
  <div class="px-2 anime-reveal-header">
    <span class="text-emerald-500 text-[10px] font-bold uppercase tracking-[0.4em]">[02] TRAYECTORIA</span>
    <h2 class="text-white text-4xl font-bold mt-2">Experiencia profesional</h2>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {jobs.map((job) => (
      <article class="bento-card glow-indigo rounded-2xl p-8 flex flex-col group anime-exp-card">
        <div class="flex items-center justify-between mb-6">
          <span class="text-[10px] text-slate-500 font-mono tracking-widest uppercase">{job.period}</span>
          {job.current && (
            <span class="px-3 py-1 bg-emerald-500 text-slate-950 text-[9px] font-black rounded-full uppercase tracking-tighter">Actual</span>
          )}
        </div>
        <h3 class="text-white text-2xl font-bold mb-1">{job.company}</h3>
        <p class="text-indigo-400 text-sm font-bold mb-6 uppercase tracking-wider">{job.role}</p>
        <ul class="space-y-3 text-sm leading-relaxed">
          {job.highlights.map((h) => (
            <li class="flex gap-3">
              <span class="mt-2 w-1.5 h-1.5 shrink-0 bg-emerald-500/20 border border-emerald-500 rounded-sm"></span>
              <span class="text-slate-400"><strong class="text-slate-200 font-semibold">{h.title}.</strong> {h.text}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
