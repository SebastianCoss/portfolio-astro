---
import { jobs } from '../data/cv';
import Art from './Art.astro';
const look = [
  { color: 'bg-c-blue', art: 'nodes' },
  { color: 'bg-c-red', art: 'phone' },
  { color: 'bg-c-purple', art: 'grid' },
  { color: 'bg-c-green', art: 'bars' },
];
---

<section id="experiencia">
  <h2 class="sec-title"><span class="bg-c-blue"></span>Experiencia</h2>
  <div class="space-y-4">
    {jobs.map((job, i) => (
      <article data-perch class="bg-panel rounded-xl overflow-hidden sm:flex reveal">
        <div class:list={['card-art h-20 sm:h-auto sm:w-28 shrink-0', look[i % look.length].color]}>
          <Art kind={look[i % look.length].art} />
        </div>
        <div class="p-5 md:p-6 flex-1">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-xl">{job.company}</h3>
            <p class="note">
              {job.period}
              {job.current && <span class="ml-2 px-1.5 py-0.5 rounded bg-cream text-night">ahora</span>}
            </p>
          </div>
          <p class="text-cream/70 mb-3">{job.role}</p>
          <ul class="space-y-1.5 text-[15px] list-disc pl-5 marker:text-cream/40">
            {job.highlights.map((h) => (
              <li><strong>{h.title}.</strong> <span class="text-cream/70">{h.text}</span></li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
