---
// Sorpresas escondidas:
//  1. Mensaje en la consola del navegador para quien abra las herramientas de desarrollo.
//  2. Terminal secreta: se abre con el boton ">_" del pie o tecleando "sudo" en cualquier parte.
//  3. Codigo Konami (↑ ↑ ↓ ↓ ← → ← → B A): lluvia de bolas de estambre y gatos.
// Todo lo que imprime la terminal va con textContent; no se interpreta HTML.
import { content, site, type Lang } from '../data/cv';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang];
const data = {
  lang,
  email: site.email,
  linkedin: site.linkedin,
  github: site.github,
  cv: site.cv[lang],
  role: `${c.ui.role1} · ${c.ui.role2}`,
  location: c.ui.location1,
  headline: c.profile.headline,
  projects: c.projects.map((p) => ({ name: p.name, status: p.status, tags: p.tags.join(', ') })),
  jobs: c.jobs.map((j) => `${j.period.padEnd(22)} ${j.company} · ${j.role}`),
  skills: c.stackGroups.map((g) => `${g.title}: ${g.items.join(', ')}`),
};
---

<section id="term" role="dialog" aria-label="Terminal" hidden data-info={JSON.stringify(data)}>
  <header>
    <span class="term-dots"><i></i><i></i><i></i></span>
    <span class="term-title">cristobal@portafolio: ~</span>
    <button id="term-close" type="button" aria-label={lang === 'es' ? 'Cerrar terminal' : 'Close terminal'}>✕</button>
  </header>
  <div id="term-out" aria-live="polite"></div>
  <form id="term-form" autocomplete="off">
    <label for="term-in">$</label>
    <input id="term-in" type="text" maxlength="60" spellcheck="false" autocapitalize="off" />
  </form>
</section>
<div id="egg-rain" aria-hidden="true"></div>

<style is:global>
  #term {
    position: fixed; z-index: 60; left: 50%; top: 50%; translate: -50% -50%;
    width: min(94vw, 42rem); height: min(80vh, 28rem); display: flex; flex-direction: column;
    background: #060f14; color: #d7e3d0; border: 2px solid #f4f1d2; border-radius: 10px; overflow: hidden;
    font: 400 14px/1.55 "IBM Plex Mono", ui-monospace, monospace; box-shadow: 8px 8px 0 rgba(0,0,0,.45);
  }
  #term[hidden] { display: none; }
  #term header { display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: #12252e; color: #a9b3a6; font-size: 12px; }
  .term-dots { display: flex; gap: 6px; }
  .term-dots i { width: 10px; height: 10px; border-radius: 50%; background: #d5503f; }
  .term-dots i:nth-child(2) { background: #d39b2f; }
  .term-dots i:nth-child(3) { background: #4d7a57; }
  .term-title { flex: 1; }
  #term-close { color: #f4f1d2; width: 28px; height: 28px; border-radius: 6px; cursor: pointer; }
  #term-close:hover { background: rgba(255,255,255,.1); }
  #term-out { flex: 1; overflow-y: auto; padding: 12px 14px 4px; white-space: pre-wrap; overflow-wrap: anywhere; }
  #term-out .cmd { color: #f4f1d2; }
  #term-out .cmd::before { content: "$ "; color: #2b8a85; }
  #term-out .ok { color: #7fc48b; }
  #term-out .warn { color: #e0b04a; }
  #term-form { display: flex; gap: 8px; padding: 8px 14px 12px; }
  #term-form label { color: #2b8a85; }
  #term-in { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: #f4f1d2; font: inherit; caret-color: #ffd23f; }

  #egg-rain { position: fixed; inset: 0; z-index: 55; pointer-events: none; overflow: hidden; }
  .egg-drop { position: absolute; top: -40px; font-size: 26px; animation: egg-fall linear forwards; }
  .egg-drop.ball { width: 22px; height: 22px; border-radius: 50%; box-shadow: inset -4px -4px 0 rgba(0,0,0,.28), 0 0 0 2px #f4f1d2; }
  @keyframes egg-fall { to { transform: translateY(110vh) rotate(540deg); } }
  @media (prefers-reduced-motion: reduce) { .egg-drop { animation-duration: .01s !important; } }
</style>

<script>
  // ---------- 1. consola ----------
  const CAT = [
    '   /\\_/\\  ',
    '  ( o.o ) ',
    '   > ^ <  ',
  ].join('\n');
  const term = document.getElementById('term') as HTMLElement;
  const info = JSON.parse(term.dataset.info || '{}');
  const es = info.lang === 'es';
  console.log(`%c${CAT}`, 'color:#ffd23f;font:700 16px monospace');
  console.log(
    `%c${es ? '¿Revisando el código? Así me gusta.' : 'Reading the code? I like that.'}`,
    'color:#f4f1d2;background:#0b1920;font:700 14px monospace;padding:6px 10px;border-radius:4px',
  );
  console.log(es
    ? `Este sitio es Astro + Tailwind, sin frameworks en el cliente. El gato es un <canvas> con física a 60 pasos por segundo.\nPrueba teclear "sudo" en la página, o el código Konami.\nEscríbeme: ${info.email}`
    : `This site is Astro + Tailwind, no client framework. The cat is a <canvas> with physics at 60 steps per second.\nTry typing "sudo" on the page, or the Konami code.\nWrite to me: ${info.email}`);

  // ---------- 2. terminal ----------
  const out = document.getElementById('term-out') as HTMLElement;
  const form = document.getElementById('term-form') as HTMLFormElement;
  const input = document.getElementById('term-in') as HTMLInputElement;
  const closeBtn = document.getElementById('term-close') as HTMLButtonElement;
  const history: string[] = [];
  let hIdx = 0, opener: HTMLElement | null = null;

  const print = (text: string, cls = '') => {
    const d = document.createElement('div');
    if (cls) d.className = cls;
    d.textContent = text;
    out.appendChild(d);
    out.scrollTop = out.scrollHeight;
  };

  const HELP = es
    ? ['Comandos disponibles:', '  whoami            quién soy', '  ls                qué hay aquí', '  ls proyectos      mis proyectos', '  cat cv.txt        resumen del CV', '  git log           mi trayectoria', '  skills            con qué trabajo', '  contacto          cómo escribirme', '  sudo contratar    lo que estás pensando', '  miau              ...', '  clear / exit']
    : ['Available commands:', '  whoami            who I am', '  ls                what is here', '  ls projects       my projects', '  cat cv.txt        résumé summary', '  git log           my career', '  skills            what I work with', '  contact           how to reach me', '  sudo hire         what you are thinking', '  meow              ...', '  clear / exit'];

  const run = (raw: string) => {
    const cmd = raw.trim().toLowerCase().replace(/\s+/g, ' ');
    print(raw, 'cmd');
    if (!cmd) return;
    if (cmd === 'help' || cmd === 'ayuda' || cmd === '?') HELP.forEach((l) => print(l));
    else if (cmd === 'whoami') { print('Cristóbal Sebastián García Coss'); print(info.role); print(info.location); print(info.headline, 'ok'); }
    else if (cmd === 'ls' || cmd === 'ls -la' || cmd === 'ls -l') print(es ? 'cv.txt   proyectos/   skills/   contacto.txt   gato.exe' : 'cv.txt   projects/   skills/   contact.txt   cat.exe');
    else if (/^ls (proyectos|projects)\/?$/.test(cmd)) info.projects.forEach((p: any) => print(`${p.name}  [${p.status}]\n    ${p.tags}`));
    else if (cmd === 'cat cv.txt' || cmd === 'cv') { print(info.headline); print(''); info.jobs.forEach((j: string) => print(j)); print(''); print((es ? 'PDF completo: ' : 'Full PDF: ') + location.origin + info.cv, 'ok'); }
    else if (cmd === 'git log' || cmd === 'git log --oneline') info.jobs.forEach((j: string, i: number) => print(`${(0xa3f9c1 + i * 0x1b2d).toString(16).slice(0, 7)}  ${j}`));
    else if (cmd === 'skills' || cmd === 'ls skills' || cmd === 'ls skills/') info.skills.forEach((s: string) => print(s));
    else if (cmd === 'contacto' || cmd === 'contact' || /^cat (contacto|contact)\.txt$/.test(cmd)) { print(info.email); print(info.linkedin); print(info.github); }
    else if (cmd === 'sudo contratar' || cmd === 'sudo hire' || cmd === 'sudo hire cristobal' || cmd === 'sudo contratar cristobal') {
      print(es ? '[sudo] contraseña para reclutador: ********' : '[sudo] password for recruiter: ********');
      print(es ? 'Permiso concedido. Abriendo canal de contacto…' : 'Permission granted. Opening contact channel…', 'ok');
      print(info.email, 'ok');
    }
    else if (cmd.startsWith('sudo')) print(es ? 'Buen intento. Prueba "sudo contratar".' : 'Nice try. Try "sudo hire".', 'warn');
    else if (cmd === 'miau' || cmd === 'meow' || cmd === './gato.exe' || cmd === 'gato.exe' || cmd === './cat.exe' || cmd === 'cat.exe') { print(CAT, 'warn'); print(es ? 'prrr…' : 'purr…'); }
    else if (cmd === 'rm -rf /' || cmd === 'rm -rf *') print(es ? 'Tranquilo. Aquí no se borra nada: hay respaldos.' : 'Easy. Nothing gets deleted here: there are backups.', 'warn');
    else if (cmd === 'clear' || cmd === 'cls') out.textContent = '';
    else if (cmd === 'exit' || cmd === 'quit' || cmd === ':q') closeTerm();
    else print((es ? 'comando no encontrado: ' : 'command not found: ') + raw.trim().slice(0, 40) + (es ? '. Escribe "help".' : '. Type "help".'), 'warn');
  };

  const openTerm = () => {
    if (!term.hidden) return;
    opener = document.activeElement as HTMLElement | null;
    term.hidden = false;
    if (!out.childElementCount) print(es ? 'Encontraste la terminal. Escribe "help" para ver los comandos.' : 'You found the terminal. Type "help" to see the commands.', 'ok');
    input.focus();
  };
  const closeTerm = () => { term.hidden = true; opener?.focus?.(); };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = input.value.slice(0, 60);
    if (v.trim()) { history.push(v); hIdx = history.length; }
    input.value = '';
    run(v);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp' && history.length) { hIdx = Math.max(0, hIdx - 1); input.value = history[hIdx]; e.preventDefault(); }
    if (e.key === 'ArrowDown' && history.length) { hIdx = Math.min(history.length, hIdx + 1); input.value = history[hIdx] || ''; e.preventDefault(); }
  });
  closeBtn.addEventListener('click', closeTerm);
  document.querySelectorAll('[data-open-term]').forEach((b) => b.addEventListener('click', openTerm));

  // ---------- 3. Konami + palabra secreta ----------
  const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  const rain = document.getElementById('egg-rain') as HTMLElement;
  const COLORS = ['#d5503f', '#d39b2f', '#2b8a85', '#7d5296', '#4c5f88', '#c4567a'];
  let kPos = 0, typed = '', raining = false;

  const party = () => {
    if (raining) return;
    raining = true;
    for (let i = 0; i < 46; i++) {
      const d = document.createElement('div');
      const isCat = i % 5 === 0;
      d.className = 'egg-drop' + (isCat ? '' : ' ball');
      if (isCat) d.textContent = '🐈‍⬛'; else d.style.background = COLORS[i % COLORS.length];
      d.style.left = Math.random() * 100 + 'vw';
      d.style.animationDuration = 2.2 + Math.random() * 2.2 + 's';
      d.style.animationDelay = Math.random() * 1.6 + 's';
      rain.appendChild(d);
    }
    setTimeout(() => { rain.textContent = ''; raining = false; }, 6400);
  };

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !term.hidden) { closeTerm(); return; }
    const t = e.target as HTMLElement;
    const inField = t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement || t?.isContentEditable;

    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    kPos = key === KONAMI[kPos] ? kPos + 1 : key === KONAMI[0] ? 1 : 0;
    if (kPos === KONAMI.length) { kPos = 0; party(); }

    if (inField || e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key.length === 1) {
      typed = (typed + e.key.toLowerCase()).slice(-6);
      if (typed.endsWith('sudo')) { typed = ''; e.preventDefault(); openTerm(); }
    }
  });
</script>
