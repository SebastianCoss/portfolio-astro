---
import {
  Database,
  Cloud,
  Code2,
  Boxes,
  Workflow,
  GitBranch,
} from "lucide-react";
---

<section id="tech-stack" class="w-full py-20 sm:py-24 lg:py-28">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center"
  >
    <div class="text-center mb-14 sm:mb-16 lg:mb-20 max-w-4xl">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        Tech Stack
      </h2>
      <p class="text-slate-400 text-base sm:text-lg lg:text-xl leading-relaxed">
        Tecnologías y herramientas que domino
      </p>
    </div>

    <!-- Grid usando TODO el ancho del max-w-7xl -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8 sm:gap-x-8 sm:gap-y-10 lg:gap-x-10 lg:gap-y-12 w-full max-w-5xl mx-auto"
    >
      <!-- Core Technologies -->
      <div
        class="w-full max-w-md mx-auto p-6 sm:p-7 lg:p-8 bg-slate-900/50 backdrop-blur-sm rounded-3xl border border-slate-800/60 hover:bg-slate-900/70 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center justify-center gap-3 mb-6">
          <div
            class="p-3 bg-emerald-500/10 rounded-lg group-hover:bg-emerald-500/20 transition-colors"
          >
            <Code2 className="w-6 h-6 text-emerald-400" />
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-white">Core</h3>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >.NET 8</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >C#</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >ASP.NET Core</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Entity Framework</span
          >
        </div>
      </div>

      <!-- Databases -->
      <div
        class="w-full max-w-md mx-auto p-6 sm:p-7 lg:p-8 bg-slate-900/50 backdrop-blur-sm rounded-3xl border border-slate-800/60 hover:bg-slate-900/70 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center justify-center gap-3 mb-6">
          <div
            class="p-3 bg-cyan-500/10 rounded-lg group-hover:bg-cyan-500/20 transition-colors"
          >
            <Database className="w-6 h-6 text-cyan-400" />
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-white">
            Databases
          </h3>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >SQL Server</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >PostgreSQL</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Redis</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >MongoDB</span
          >
        </div>
      </div>

      <!-- Architecture -->
      <div
        class="w-full max-w-md mx-auto p-6 sm:p-7 lg:p-8 bg-slate-900/50 backdrop-blur-sm rounded-3xl border border-slate-800/60 hover:bg-slate-900/70 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center justify-center gap-3 mb-6">
          <div
            class="p-3 bg-indigo-500/10 rounded-lg group-hover:bg-indigo-500/20 transition-colors"
          >
            <Boxes className="w-6 h-6 text-indigo-400" />
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-white">
            Architecture
          </h3>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Clean Architecture</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Microservices</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >DDD</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Event-Driven</span
          >
        </div>
      </div>

      <!-- Cloud & DevOps -->
      <div
        class="w-full max-w-md mx-auto p-6 sm:p-7 lg:p-8 bg-slate-900/50 backdrop-blur-sm rounded-3xl border border-slate-800/60 hover:bg-slate-900/70 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center justify-center gap-3 mb-6">
          <div
            class="p-3 bg-purple-500/10 rounded-lg group-hover:bg-purple-500/20 transition-colors"
          >
            <Cloud className="w-6 h-6 text-purple-400" />
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-white">
            Cloud & DevOps
          </h3>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >AWS</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Azure</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Docker</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Kubernetes</span
          >
        </div>
      </div>

      <!-- Messaging -->
      <div
        class="w-full max-w-md mx-auto p-6 sm:p-7 lg:p-8 bg-slate-900/50 backdrop-blur-sm rounded-3xl border border-slate-800/60 hover:bg-slate-900/70 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center justify-center gap-3 mb-6">
          <div
            class="p-3 bg-orange-500/10 rounded-lg group-hover:bg-orange-500/20 transition-colors"
          >
            <Workflow className="w-6 h-6 text-orange-400" />
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-white">
            Messaging
          </h3>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Kafka</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >RabbitMQ</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >SignalR</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >gRPC</span
          >
        </div>
      </div>

      <!-- CI/CD & Tools -->
      <div
        class="w-full max-w-md mx-auto p-6 sm:p-7 lg:p-8 bg-slate-900/50 backdrop-blur-sm rounded-3xl border border-slate-800/60 hover:bg-slate-900/70 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center justify-center gap-3 mb-6">
          <div
            class="p-3 bg-pink-500/10 rounded-lg group-hover:bg-pink-500/20 transition-colors"
          >
            <GitBranch className="w-6 h-6 text-pink-400" />
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-white">
            CI/CD & Tools
          </h3>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >GitHub Actions</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Azure DevOps</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >Git</span
          >
          <span
            class="px-4 py-2.5 bg-slate-700/30 text-slate-300 text-sm sm:text-base rounded-lg font-medium"
            >SonarQube</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
