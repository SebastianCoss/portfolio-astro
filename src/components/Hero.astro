---
import { ArrowRight, Download, MapPin } from 'lucide-react';
import { profile, stats } from '../data/cv';
---

<section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
  <div class="lg:col-span-8 bento-card glow-indigo rounded-2xl p-8 md:p-12 flex flex-col justify-center">
    <div class="hero-content space-y-8">
      <div class="space-y-4">
        <span class="block text-emerald-400 text-xs font-bold uppercase tracking-[0.3em] overflow-hidden">
          <span class="inline-block anime-hero-label">{profile.role} · {profile.tagline}</span>
        </span>
        <h1 class="text-white text-5xl md:text-7xl font-bold leading-[0.9] tracking-tighter">
          <span class="block overflow-hidden"><span class="inline-block anime-hero-title">Cristóbal</span></span>
          <span class="block overflow-hidden"><span class="inline-block anime-hero-title">Sebastián</span></span>
          <span class="block overflow-hidden text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-indigo-500">
            <span class="inline-block anime-hero-title">García Coss</span>
          </span>
        </h1>
      </div>
      <p class="text-slate-400 text-lg md:text-xl max-w-2xl leading-relaxed anime-hero-text">
        Modernizo sistemas legacy hacia <span class="text-white font-medium">APIs y microservicios</span> con
        <span class="text-white font-medium">.NET 10</span> y Clean Architecture. Líder técnico en producción
        para el sector financiero y empresarial, con agentes de IA en todo el ciclo de desarrollo.
      </p>
      <div class="flex flex-wrap gap-4 anime-hero-buttons">
        <a href="#projects" class="px-8 py-4 bg-emerald-500 text-slate-950 font-bold rounded-xl flex items-center gap-2 hover:translate-y-[-2px] active:scale-95 transition-all">
          Ver proyectos <ArrowRight className="w-4 h-4" />
        </a>
        <a href={profile.cvFile} download class="px-8 py-4 bg-slate-800/50 text-white font-bold rounded-xl border border-slate-700 hover:bg-slate-800 transition-all flex items-center gap-2">
          Descargar CV <Download className="w-4 h-4" />
        </a>
        <button type="button" data-open-chat class="px-8 py-4 text-emerald-300 font-bold rounded-xl border border-emerald-500/40 hover:bg-emerald-500/10 transition-all">
          Pregúntale a mi CV
        </button>
      </div>
    </div>
  </div>

  <div class="lg:col-span-4 grid grid-cols-2 gap-4 anime-hero-image">
    {stats.map((s) => (
      <div class="bento-card rounded-2xl p-6 flex flex-col justify-between min-h-32">
        <span class="text-3xl md:text-4xl font-bold text-white tracking-tight">{s.value}</span>
        <span class="text-xs text-slate-400 leading-snug mt-3">{s.label}</span>
      </div>
    ))}
    <div class="bento-card rounded-2xl p-6 col-span-2 flex items-center gap-3">
      <MapPin className="w-5 h-5 text-emerald-400 shrink-0" />
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-400">Ubicación</p>
        <p class="text-white font-bold">{profile.location}</p>
      </div>
    </div>
  </div>
</section>
