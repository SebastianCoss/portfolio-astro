---
// Chat "Pregúntale a mi CV". Habla con /api/chat (servicio propio en el VPS, que llama a Claude
// con el CV como contexto). Todo el texto se pinta con textContent: nada de HTML del modelo.
import { content, type Lang } from '../data/cv';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang];
const ui = c.ui;
---

<button id="chat-fab" type="button" data-open-chat aria-controls="chat-panel" aria-expanded="false"
  class="fixed right-4 bottom-4 z-50 px-5 py-3 rounded-lg bg-cream text-night font-bold text-[15px] border-2 border-cream hover:bg-night hover:text-cream transition-colors">
  {ui.askCv}
</button>

<section id="chat-panel" role="dialog" aria-label={ui.askCv} hidden
  data-typing={ui.chatTyping} data-error={ui.chatError} data-offline={ui.chatOffline}
  class="fixed z-50 right-4 bottom-4 w-[min(92vw,24rem)] h-[min(78vh,34rem)] flex flex-col rounded-xl border-2 border-cream bg-panel overflow-hidden">
  <header class="on-color flex items-center justify-between px-4 py-3 bg-c-blue">
    <div>
      <p class="font-bold">{ui.askCv}</p>
      <p class="font-mono text-[11px] text-cream/80">{ui.chatSub}</p>
    </div>
    <button id="chat-close" type="button" aria-label={ui.chatClose} class="w-9 h-9 rounded-lg hover:bg-black/20">✕</button>
  </header>

  <div id="chat-log" class="flex-1 overflow-y-auto px-4 py-4 space-y-3 text-[15px]" aria-live="polite">
    <div class="chat-msg bot">{ui.chatHello}</div>
    <div id="chat-suggest" class="flex flex-wrap gap-2 pt-1">
      {c.chatSuggestions.map((s) => (
        <button type="button" data-q={s} class="text-[13px] px-3 py-1.5 rounded-lg bg-panel-2 text-cream/85 hover:bg-cream hover:text-night transition-colors">{s}</button>
      ))}
    </div>
  </div>

  <form id="chat-form" class="p-3 bg-night flex gap-2" autocomplete="off">
    <input id="chat-input" type="text" maxlength="300" placeholder={ui.chatPlaceholder} aria-label={ui.chatPlaceholder}
      class="flex-1 min-w-0 bg-panel border-2 border-panel-2 rounded-lg px-3 py-2 text-[15px] text-cream placeholder:text-dim focus:border-cream outline-none" />
    <button id="chat-send" type="submit" class="px-4 rounded-lg bg-cream text-night font-bold text-[15px] disabled:opacity-40">{ui.chatSend}</button>
  </form>
</section>

<style is:global>
  /* El chat solo aparece si el servicio responde (ver script). */
  html:not(.chat-ready) [data-open-chat] { display: none !important; }
  .chat-msg { max-width: 88%; padding: .55rem .8rem; border-radius: .7rem; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
  .chat-msg.bot { background: var(--color-panel-2); color: var(--color-cream); border-bottom-left-radius: .2rem; }
  .chat-msg.me { margin-left: auto; background: var(--color-cream); color: var(--color-night); border-bottom-right-radius: .2rem; }
  .chat-msg.err { background: #d5503f; color: #f4f1d2; }
  .chat-msg.typing { color: var(--color-dim); }
</style>

<script>
  const fab = document.getElementById('chat-fab') as HTMLButtonElement;
  const panel = document.getElementById('chat-panel') as HTMLElement;
  const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;
  const log = document.getElementById('chat-log') as HTMLElement;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const send = document.getElementById('chat-send') as HTMLButtonElement;
  const suggest = document.getElementById('chat-suggest') as HTMLElement;
  const T = panel.dataset as { typing: string; error: string; offline: string };

  type Turn = { role: 'user' | 'assistant'; content: string };
  const history: Turn[] = [];
  let busy = false;

  fetch('/api/health').then((r) => { if (r.ok) document.documentElement.classList.add('chat-ready'); }).catch(() => {});

  const open = () => {
    panel.hidden = false; fab.hidden = true; fab.setAttribute('aria-expanded', 'true');
    input.focus();
  };
  const close = () => {
    panel.hidden = true; fab.hidden = false; fab.setAttribute('aria-expanded', 'false');
    fab.focus();
  };

  document.querySelectorAll('[data-open-chat]').forEach((el) => el.addEventListener('click', open));
  closeBtn.addEventListener('click', close);
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) close(); });

  const add = (text: string, cls: string) => {
    const div = document.createElement('div');
    div.className = `chat-msg ${cls}`;
    div.textContent = text;
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
    return div;
  };

  async function ask(question: string) {
    const q = question.trim().slice(0, 300);
    if (!q || busy) return;
    busy = true; send.disabled = true; input.value = '';
    suggest.remove();
    add(q, 'me');
    const typing = add(T.typing, 'bot typing');

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: [...history, { role: 'user', content: q }].slice(-6) }),
      });
      const data = await res.json().catch(() => ({}));
      typing.remove();
      if (!res.ok || typeof data.reply !== 'string') {
        add(typeof data.error === 'string' ? data.error : T.error, 'err');
      } else {
        history.push({ role: 'user', content: q }, { role: 'assistant', content: data.reply });
        add(data.reply, 'bot');
      }
    } catch {
      typing.remove();
      add(T.offline, 'err');
    } finally {
      busy = false; send.disabled = false; input.focus();
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
  suggest.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-q]') as HTMLElement | null;
    if (b) ask(b.dataset.q || '');
  });
</script>
