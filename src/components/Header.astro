---
const links = [
  { href: '#experiencia', text: 'Experiencia' },
  { href: '#proyectos', text: 'Proyectos' },
  { href: '#stack', text: 'Stack' },
  { href: '#contacto', text: 'Contacto' },
];
---

<header class="sticky top-0 z-30 bg-paper/90 backdrop-blur border-b border-line">
  <div class="max-w-5xl mx-auto px-6 md:px-8 h-14 flex items-center justify-between">
    <a href="#top" class="font-display text-lg font-semibold">Cristóbal García</a>
    <nav class="flex items-center gap-5 text-[15px]" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} class:list={['hover:text-rust transition-colors', l.href !== '#contacto' && 'hidden sm:inline']}>{l.text}</a>
      ))}
    </nav>
  </div>
</header>
