---
const links = [
  { href: '#perfil', text: 'Perfil' },
  { href: '#experiencia', text: 'Experiencia' },
  { href: '#proyectos', text: 'Proyectos' },
  { href: '#stack', text: 'Habilidades' },
  { href: '#contacto', text: 'Contacto' },
];
---

<header class="sticky top-0 z-30 bg-night/90 backdrop-blur">
  <div class="max-w-6xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-3 font-bold" aria-label="Inicio">
      <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="none" stroke="#f4f1d2" stroke-width="2.5" />
        <path d="M20 8 L31 28 L9 28 Z" fill="#f4f1d2" />
        <circle cx="20" cy="22" r="4" fill="#0b1920" />
      </svg>
      <span class="hidden sm:inline">Cristóbal García</span>
    </a>
    <nav class="flex items-center gap-1 text-[15px]" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} class:list={['px-3 py-2 rounded-lg hover:bg-panel-2 transition-colors', l.href !== '#contacto' && 'hidden md:inline']}>{l.text}</a>
      ))}
    </nav>
  </div>
</header>
