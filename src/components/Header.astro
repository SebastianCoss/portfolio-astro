---
import { content, type Lang } from '../data/cv';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = content[lang].ui;
const links = [
  { href: '#perfil', text: ui.navProfile },
  { href: '#experiencia', text: ui.navExperience },
  { href: '#proyectos', text: ui.navProjects },
  { href: '#stack', text: ui.navSkills },
  { href: '#contacto', text: ui.navContact },
];
---

<header class="sticky top-0 z-30 bg-night/90 backdrop-blur transition-colors">
  <div class="max-w-6xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between gap-3">
    <a href="#top" class="flex items-center gap-3 font-bold shrink-0" aria-label="Inicio">
      <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5" />
        <path d="M20 8 L31 28 L9 28 Z" fill="currentColor" />
        <circle cx="20" cy="22" r="4" fill="var(--color-night)" />
      </svg>
      <span class="hidden sm:inline">Cristóbal García</span>
    </a>
    <nav class="hidden lg:flex items-center gap-1 text-[15px]" aria-label="Principal">
      {links.map((l) => <a href={l.href} class="px-3 py-2 rounded-lg hover:bg-panel-2 transition-colors">{l.text}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <div class="flex rounded-lg border-2 border-cream overflow-hidden font-mono text-[13px] font-bold" role="group" aria-label={ui.langSwitch}>
        <a href="/" hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined} class:list={['px-2.5 py-1.5 transition-colors', lang === 'es' ? 'bg-cream text-night' : 'hover:bg-panel-2']}>ES</a>
        <a href="/en/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} class:list={['px-2.5 py-1.5 transition-colors', lang === 'en' ? 'bg-cream text-night' : 'hover:bg-panel-2']}>EN</a>
      </div>
      <button id="theme-toggle" type="button" aria-label={ui.themeToggle} title={ui.themeToggle}
        class="w-10 h-10 grid place-items-center rounded-lg border-2 border-cream hover:bg-panel-2 transition-colors">
        <svg class="theme-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor" /></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="currentColor" /><path d="M12 1v4M12 19v4M1 12h4M19 12h4M4.2 4.2l2.8 2.8M17 17l2.8 2.8M4.2 19.800l2.8-2.8M17 7l2.8-2.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>

<style is:global>
  html[data-theme="day"] .theme-moon, html:not([data-theme="day"]) .theme-sun { display: none; }
</style>
