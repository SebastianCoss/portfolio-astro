---
import { profile } from '../data/cv';
---

<footer id="contacto" class="max-w-6xl mx-auto px-5 md:px-8 pt-10 pb-10">
  <div data-perch class="bg-c-red rounded-xl p-7 md:p-9 flex flex-wrap items-center justify-between gap-6">
    <div>
      <h2 class="text-2xl md:text-3xl">¿Tienes un sistema que mejorar?</h2>
      <p class="mt-2 text-cream/90">Escríbeme y lo platicamos. Respondo yo, no un formulario.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={`mailto:${profile.email}`} class="btn btn-solid">Escribirme</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-line">LinkedIn</a>
    </div>
  </div>
  <p class="mt-6 font-mono text-[12px] text-dim">
    © 2026 Cristóbal Sebastián García Coss · Hecho en Morelos con Astro. El gato todavía no tiene nombre.
  </p>
</footer>
