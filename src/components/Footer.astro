---
import { profile } from '../data/cv';

const links = [
  { label: 'Email', text: profile.email, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', text: 'crisegarcoss', href: profile.linkedin },
  { label: 'GitHub', text: 'SebastianCoss', href: profile.github },
  { label: 'Empresa', text: 'sysfactory.net', href: profile.company },
];
---

<footer class="mt-24 border-t border-slate-800/50 bg-slate-900/30 backdrop-blur-md" id="contact">
  <div class="max-w-7xl mx-auto px-6 py-20 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
    <div class="space-y-8 anime-reveal-left">
      <h2 class="text-white text-5xl font-bold tracking-tighter leading-none">Hablemos de<br /><span class="text-emerald-500">sistemas.</span></h2>
      <p class="text-slate-400 text-lg">Disponible para proyectos estratégicos, liderazgo técnico y consultoría en arquitectura de software.</p>
      <button type="button" data-open-chat class="px-6 py-3 text-emerald-300 font-bold rounded-xl border border-emerald-500/40 hover:bg-emerald-500/10 transition-all">
        O pregúntale a mi CV
      </button>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 anime-reveal-right">
      {links.map((l) => (
        <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="bento-card glow-indigo rounded-2xl p-6 group flex flex-col gap-1">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">{l.label}</span>
          <span class="text-white group-hover:text-emerald-400 transition-colors font-bold break-all">{l.text}</span>
        </a>
      ))}
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-6 py-10 border-t border-slate-800/30 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] text-slate-600 font-mono tracking-widest">
    <p>&copy; 2026 CRISTÓBAL SEBASTIÁN GARCÍA COSS.</p>
    <div class="flex gap-6 uppercase">
      <span>Temixco, Morelos · México</span>
      <span class="text-emerald-500/50">Backend .NET</span>
    </div>
  </div>
</footer>
