---
import { content, site, type Lang } from '../data/cv';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = content[lang].ui;
---

<footer id="contacto" class="max-w-6xl mx-auto px-5 md:px-8 pt-10 pb-10">
  <div data-perch class="on-color bg-c-red rounded-xl p-7 md:p-9 flex flex-wrap items-center justify-between gap-6">
    <div>
      <h2 class="text-2xl md:text-3xl">{ui.footerTitle}</h2>
      <p class="mt-2 text-cream/90">{ui.footerText}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-solid">{ui.whatsapp}</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-line">{ui.linkedin}</a>
      <a href={`mailto:${site.email}`} class="btn btn-line">{ui.emailBtn}</a>
    </div>
  </div>
  <p class="mt-6 font-mono text-[12px] text-dim flex flex-wrap items-center gap-x-3 gap-y-2">
    <span>© 2026 Cristóbal Sebastián García Coss · {ui.footerNote}</span>
    <button type="button" data-open-term aria-label="Terminal" title="Terminal" class="px-2 py-1 rounded border border-panel-2 hover:border-cream hover:text-cream transition-colors">&gt;_</button>
  </p>
</footer>
