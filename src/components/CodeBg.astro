---
// Fondo: codigo C# casi invisible que se ilumina alrededor del cursor, como una linterna.
// La capa base se pinta una sola vez; en cada movimiento solo se repintan las letras cercanas.
---

<canvas id="code-bg" aria-hidden="true"></canvas>

<style is:global>
  #code-bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
</style>

<script>
  const LINES = [
    'public sealed class ExchangeRateService(IRateProvider banxico, IRateProvider bcrp, ILogger<ExchangeRateService> log)',
    '{',
    '    public async Task<Rate> GetAsync(Currency from, Currency to, CancellationToken ct)',
    '    {',
    '        var policy = Policy.Handle<HttpRequestException>().WaitAndRetryAsync(3, n => TimeSpan.FromSeconds(Math.Pow(2, n)));',
    '        return await policy.ExecuteAsync(() => banxico.FetchAsync(from, to, ct)) ?? await bcrp.FetchAsync(from, to, ct);',
    '    }',
    '}',
    '',
    'app.MapGet("/api/v1/orders/{id:guid}", async (Guid id, IMediator mediator) => Results.Ok(await mediator.Send(new GetOrderQuery(id))));',
    'app.MapHub<MonitoringHub>("/hubs/monitoring").RequireAuthorization();',
    '',
    'public record CreateWorkOrderCommand(Guid VehicleId, string Description, decimal Estimate) : IRequest<Result<Guid>>;',
    '',
    'internal sealed class CreateWorkOrderHandler(IWorkshopDbContext db) : IRequestHandler<CreateWorkOrderCommand, Result<Guid>>',
    '{',
    '    public async Task<Result<Guid>> Handle(CreateWorkOrderCommand cmd, CancellationToken ct)',
    '    {',
    '        var order = WorkOrder.Open(cmd.VehicleId, cmd.Description, Money.Mxn(cmd.Estimate));',
    '        db.WorkOrders.Add(order);',
    '        await db.SaveChangesAsync(ct);',
    '        return Result.Ok(order.Id);',
    '    }',
    '}',
    '',
    'SELECT o.Folio, c.Name, SUM(i.Qty * i.Price) AS Total FROM Orders o JOIN Items i ON i.OrderId = o.Id GROUP BY o.Folio, c.Name;',
    '',
    'await foreach (var message in outbox.ReadPendingAsync(ct)) { await hub.SendAsync("Receive", message, ct); await outbox.MarkSentAsync(message.Id, ct); }',
    '',
    '[Fact] public async Task Folio_generator_never_repeats() => (await Generate(10_000)).Should().OnlyHaveUniqueItems();',
    '',
  ];
  const KEYWORDS = /\b(public|sealed|class|async|await|var|return|new|record|internal|Task|SELECT|FROM|JOIN|GROUP|BY|AS|ON|SUM|foreach|in)\b/g;

  const cv = document.getElementById('code-bg') as HTMLCanvasElement | null;
  if (cv) {
    const ctx = cv.getContext('2d')!;
    const base = document.createElement('canvas');
    const bctx = base.getContext('2d')!;
    const FONT = '13px "IBM Plex Mono", ui-monospace, monospace';
    const LH = 24, R = 190;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches;
    let W = 0, H = 0, CW = 8, ink = '#f4f1d2', hot = '#d39b2f', dpr = 1;
    let kw: boolean[][] = [];
    let mx = -999, my = -999, pending = false, fadeTimer: number | undefined;

    const lineAt = (row: number) => LINES[row % LINES.length];

    const build = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      for (const c of [cv, base]) { c.width = W * dpr; c.height = H * dpr; }
      const css = getComputedStyle(document.documentElement);
      ink = css.getPropertyValue('--color-cream').trim() || ink;
      hot = css.getPropertyValue('--color-c-mustard').trim() || hot;
      kw = LINES.map((l) => { const a = Array(l.length).fill(false); for (const m of l.matchAll(KEYWORDS)) for (let i = 0; i < m[0].length; i++) a[m.index! + i] = true; return a; });
      bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      bctx.clearRect(0, 0, W, H);
      bctx.font = FONT; bctx.textBaseline = 'top';
      CW = bctx.measureText('M').width;
      bctx.fillStyle = ink; bctx.globalAlpha = 0.055;
      for (let r = 0; r * LH < H; r++) bctx.fillText(lineAt(r), 16, r * LH + 6);
      paint();
    };

    const paint = () => {
      pending = false;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, cv.width, cv.height);
      ctx.drawImage(base, 0, 0);
      if (mx < -900 || calm || !fine) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = FONT; ctx.textBaseline = 'top';
      const r0 = Math.max(0, Math.floor((my - R) / LH)), r1 = Math.ceil((my + R) / LH);
      for (let r = r0; r <= r1; r++) {
        const line = lineAt(r), li = r % LINES.length;
        const y = r * LH + 6;
        const c0 = Math.max(0, Math.floor((mx - R - 16) / CW)), c1 = Math.min(line.length - 1, Math.ceil((mx + R - 16) / CW));
        for (let c = c0; c <= c1; c++) {
          const ch = line[c];
          if (ch === ' ') continue;
          const x = 16 + c * CW;
          const d = Math.hypot(x + CW / 2 - mx, y + 8 - my);
          if (d > R) continue;
          const k = 1 - d / R;
          ctx.globalAlpha = k * k * 0.6;
          ctx.fillStyle = kw[li][c] ? hot : ink;
          ctx.fillText(ch, x, y);
        }
      }
      ctx.globalAlpha = 1;
    };

    const request = () => { if (!pending) { pending = true; requestAnimationFrame(paint); } };
    addEventListener('mousemove', (e) => {
      mx = e.clientX; my = e.clientY; request();
      clearTimeout(fadeTimer);
      fadeTimer = window.setTimeout(() => { mx = -999; request(); }, 3500);   // se apaga si dejas de mover
    }, { passive: true });
    document.addEventListener('mouseleave', () => { mx = -999; request(); });
    addEventListener('resize', build);
    addEventListener('themechange', build);
    if (document.fonts?.ready) document.fonts.ready.then(build); else build();
  }
</script>
